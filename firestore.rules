rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/storeConfig {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@digitaizesolution.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
